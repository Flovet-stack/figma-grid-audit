{
  "name": "grid-auditor",
  "version": "0.0.0",
  "description": "Dev-only web overlay that compares the expected design layout grid (columns, rows, squares as in Figma) with the grid your page actually rendered. Not affiliated with Figma.",
  "license": "MIT",
  "author": "Flovet Asong",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.4.0",
  "keywords": [
    "figma",
    "layout-grid",
    "overlay",
    "design-engineering",
    "devtools"
  ],
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && pnpm --filter playground typecheck",
    "test": "vitest run --coverage",
    "build": "tsdown",
    "test:prod-exclusion": "pnpm build && node scripts/check-prod-exclusion.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && node scripts/check-prod-exclusion.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@biomejs/biome": "2.6.6",
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.6",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "4.14.0",
    "playwright": "1.65.0",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
